<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaloniaApplication1.Views.Controls"
             x:Class="AvaloniaApplication1.Views.Controls.ColorGalleryControl"
             x:Name="root">

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="PART_ItemsControl" ItemsSource="{Binding PaddedColors, RelativeSource={RelativeSource AncestorType=local:ColorGalleryControl}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{Binding}"
                  Width="{Binding ItemSize, RelativeSource={RelativeSource AncestorType=local:ColorGalleryControl}}"
                  Height="{Binding ItemSize, RelativeSource={RelativeSource AncestorType=local:ColorGalleryControl}}"
                  Margin="1"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>

</UserControl>
